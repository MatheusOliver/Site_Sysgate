{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/politica-de-privacidade", "destination": "/privacidade.html", "permanent": true },
    { "source": "/planos", "destination": "/", "permanent": true },
    { "source": "/licencas", "destination": "/", "permanent": true },
    { "source": "/ajuda", "destination": "/", "permanent": true },
    { "source": "/orçamento", "destination": "/", "permanent": true },
    { "source": "/soluções", "destination": "/", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sysgate.com.br" }],
      "destination": "https://www.sysgate.com.br/:path*",
      "permanent": true
    }
  ]
}
